<mxfile host="app.diagrams.net" modified="2026-10-19T20:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="cu01-registrar-venta" name="CU01 Registrar venta"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#222222;fontColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="90" y="30" width="90" height="40" as="geometry"/></mxCell><mxCell id="n1" value="Seleccionar productos y cantidades mediante CU03" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="190" height="70" as="geometry"/></mxCell><mxCell id="n2" value="Validar venta no vacía y cantidades positivas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="190" height="70" as="geometry"/></mxCell><mxCell id="d1" value="¿Venta válida?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B28A2E;fontSize=16;" vertex="1" parent="1"><mxGeometry x="55" y="300" width="160" height="90" as="geometry"/></mxCell><mxCell id="e2" value="E2: venta vacía o datos no válidos. Solicitar corrección." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="230" height="90" as="geometry"/></mxCell><mxCell id="d2" value="¿Stock suficiente?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B28A2E;fontSize=16;" vertex="1" parent="1"><mxGeometry x="55" y="430" width="160" height="90" as="geometry"/></mxCell><mxCell id="e1" value="E1: rechazar la venta e informar que falta stock." style="rounded=1;whi