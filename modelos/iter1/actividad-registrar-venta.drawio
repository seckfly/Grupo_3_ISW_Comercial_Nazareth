a no esté vacía&#xa;y que las cantidades sean válidas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;strokeWidth=2;fontSize=15;fontColor=#202833;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="230" width="330" height="72" as="geometry"/></mxCell><mxCell id="dcart" value="¿Datos&#xa;válidos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B28A2E;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#202833;spacing=4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="675" y="335" width="180" height="85" as="geometry"/></mxCell><mxCell id="ecart" value="E2 · Solicitar corrección de la venta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#7F1D1D;spacing=7;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="445" width="330" height="65" as="geometry"/></mxCell><mxCell id="stock" value="Comprobar productos activos y&#xa;verificar stock suficiente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;strokeWidth=2;fontSize=15;fontColor=#202833;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="445" width="330" height="70" as="geometry"/></mxCell><mxCell id="dstock" value="¿Stock&#xa;suficiente?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B28A2E;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#202833;spacing=4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1175" y="540" width="180" height="85" as="geometry"/></mxCell><mxCell id="estock" value="E1 · Informar la falta de stock&#xa;y rechazar esta venta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#7F1D1D;spacing=7;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="550" width="330" height="75" as="geometry"/></mxCell><mxCell id="dcustomer" value="¿Cliente&#xa;registrado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B28A2E;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#202833;spacing=4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="175" y="660" width="170" height="85" as="geometry"/></mxCell><mxCell id="cu02" value="CU02 · Vincular al cliente&#xa;a la venta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;strokeWidth=2;fontSize=15;fontColor=#202833;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="770" width="330" height="65" as="geometry"/></mxCell><mxCell id="payment" value="Elegir efectivo, Yape o Plin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;strokeWidth=2;fontSize=15;fontColor=#202833;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="880" width="320" height="65" as="geometry"/></mxCell><mxCell id="calc" value="Calcular el total de la venta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;strokeWidth=2;fontSize=15;fontColor=#202833;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="880" width="330" height="65" as="geometry"/></mxCell><mxCell id="fields" value="Mostrar el total y los campos&#xa;del método de pago elegido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;strokeWidth=2;fontSize=15;fontColor=#202833;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="975" width="330" height="70" as="geometry"/></mxCell><mxCell id="enter" value="Registrar el monto recibido&#xa;o la referencia digital" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;strokeWidth=2;fontSize=15;fontColor=#202833;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="10