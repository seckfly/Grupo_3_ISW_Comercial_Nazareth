<mxfile host="app.diagrams.net" modified="2026-10-19T20:30:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="cu01-registrar-venta" name="CU01 Registrar venta"><mxGraphModel dx="1920" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lane-v" value="Vendedor (Humberto)" style="swimlane;html=1;startSize=42;horizontal=1;fillColor=#F4F6F8;swimlaneFillColor=#FFFFFF;strokeColor=#8A94A3;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="560" height="1430" as="geometry" /></mxCell><mxCell id="lane-s" value="Sistema" style="swimlane;html=1;startSize=42;horizontal=1;fillColor=#EAF1F8;swimlaneFillColor=#FFFFFF;strokeColor=#8A94A3;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="1260" height="1430" as="geometry" /></mxCell><mxCell id="start" value="" style="ellipse;html=1;aspect=fixed;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="40" height="40" as="geometry" /></mxCell><mxCell id="n1" value="Seleccionar productos y cantidades" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;fontSize=18;" vertex="1" parent="1"><mxGeometry x="100" y="230" width="440" height="80" as="geometry" /></mxCell><mxCell id="n2" value="Validar venta no vacía y cantidades positivas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;fontSize=18;" vertex="1" parent="1"><mxGeometry x="850" y="230" width="520" height="80" as="geometry" /></mxCell><mxCell id="d1" value="¿Venta válida?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B28A2E;fontSize=18;" vertex="1" parent="1"><mxGeometry x="970" y="350" width="280" height="110" as="geometry" /></mxCell><mxCell id="e2a" value="E2: venta vacía o cantidad no válida. Solicitar corrección." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1440" y="350" width="360" height="110" as="geometry" /></mxCell><mxCell id="d2" value="¿Stock suficiente en todos los productos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B28A2E;fontSize=17;" vertex="1" parent="1"><mxGeometry x="970" y="500" width="280" height="120" as="geometry" /></mxCell><mxCell id="e1" value="E1: informar el producto sin stock suficiente y rechazar la venta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1440" y="510" width="360" height="100" as="geometry" /></mxCell><mxCell id="n3" value="Si corresponde, vincular cliente registrado mediante CU02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;fontSize=17;" vertex="1" parent="1"><mxGeometry x="100" y="700" width="440" height="90" as="geometry" /></mxCell><mxCell id="n4" value="Elegir efectivo, Yape o Plin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;fontSize=18;" vertex="1" parent="1"><mxGeometry x="100" y="820" width="440" height="80" as="geometry" /></mxCell><mxCell id="n5" value="Validar método de pago y referencia digital del prototipo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;fontSize=17;" vertex="1" parent="1"><mxGeometry x="850" y="700" width="520" height="90" as="geometry" /></mxCell><mxCell id="e2b" value="E2: método no admitido. Solicitar corrección." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1440" y="700" width="360" height="90" as="geometry" /></mxCell><mxCell id="n6" value="Calcular total. En efectivo, calcular vuelto si corresponde." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;fontSize=17;" vertex="1" parent="1"><mxGeometry x="850" y="830" width="520" height="80" as="geometry" /></mxCell><mxCell id="n7" value="Iniciar transacción SQL; guardar venta, detalle y movimiento; descontar stock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#536273;fontSize=17;" vertex="1" parent="1"><mxGeometry x="850" y="950" width="520" height="100" as="geometry" /></mxCell><mxCell id="d3" value="¿Persistencia completada?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#B28A2E;fontSize=18;" vertex="1" parent="1"><mxGeometry x="970" y="1090" width="280" height="110" as="geometry" /></mxCell><mxCell id="e3" value="E3: fallo de persistencia. No confirmar la venta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#B3261E;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1440" y="1090" width="360" height="90" as="geometry" /></mxCell><mxCell id="c1" value="C1: revertir transacción. No dejar venta parcial ni stock descontado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1440" y="1210" width="360" height="100" as="geometry" /></mxCell><mxCell id="n8" value="Confirmar transacción y mostrar el identificador de venta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#548235;fontSize=18;" vertex="1" parent="1"><mxGeometry x="850" y="1260" width="520" height="80" as="geometry" /></mxCell><mxCell id="end" value="" style="ellipse;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1085" y="1400" width="44" height="44" as="geometry" /></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#536273;fontSize=15;" edge="1" parent="1" source="start" target="n1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalL